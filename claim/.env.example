# Copy to .env.local. Never commit real values.
PUBLIC_BASE_URL=http://localhost:3000
RPC_URL=https://api.mainnet-beta.solana.com
# base58 of the 64-byte treasury secret key (scripts/treasury.ts generate)
TREASURY_SECRET_KEY=
# 32 random bytes as hex: openssl rand -hex 32
CODE_PEPPER=
# openssl rand -base64 32
ADMIN_TOKEN=
# Supabase transaction pooler, role ge_api
DATABASE_URL=postgres://ge_api.<project-ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres
